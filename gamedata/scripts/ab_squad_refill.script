--- ab_squad_refill: Squad Refill - offline repair of squads below their declared minimum

local pairs, tostring, math_random = pairs, tostring, math.random
local os_clock, alife = os.clock, alife
local xlog, xsmart, xsquad, xslice, xlevel, xprofiler, xobject = xlog, xsmart, xsquad, xslice, xlevel, xprofiler, xobject
local ini_sys = ini_sys

local log = xlog.get_logger("AB.RFIL", { outfile = "alifebalance.log" })

local REFILL_JOB = "ab_refill"
local DEFAULT_CROWD_THRESHOLD = 60

local _dbg = false

-- Pass accumulators, rebuilt each pass: _cells[key] = offline body count (all squads); _candidates = below-min squads as { id, level_id, bin, cell }.
local _sweep      = { ids = {}, total = 0, cursor = 1, active = false }
local _cell_size  = 0
local _cells      = {}
local _candidates = {}

-- _pool_cache[section] = parsed npc_random array, or false when none (fixed roster); session-lifetime, squad_descr LTX is static.
local _pool_cache = {}

function set_debug(dbg)
    _dbg = dbg and true or false
end

local function is_refill_enabled()
    local mcm = ab_mcm and ab_mcm.cfg
    return mcm and mcm.enabled and mcm.refill
end

local function get_crowd_threshold()
    local mcm = ab_mcm and ab_mcm.cfg
    return (mcm and mcm.crowd_threshold) or DEFAULT_CROWD_THRESHOLD
end

--- True when the area at `position` on `level_id` is crowded: own cell at the threshold, or its 3x3 neighborhood at double.
--- Shared gate for refill drain, advance lever, and crowd delay; offline bodies from the current pass, fail-open before it.
function is_crowded(level_id, position)
    if _cell_size <= 0 or not position then return false end
    local threshold = get_crowd_threshold()
    local key = xlevel.build_cell_key(level_id, position, _cell_size)
    if not key then return false end
    if (_cells[key] or 0) >= threshold then return true end
    local sum = 0
    for dx = -1, 1 do
        for dz = -1, 1 do
            local neighbor = xlevel.build_cell_key(level_id,
                { x = position.x + dx * _cell_size, z = position.z + dz * _cell_size },
                _cell_size)
            sum = sum + (neighbor and _cells[neighbor] or 0)
        end
    end
    return sum >= threshold * 2
end

--- Parsed npc_random pool for a section, cached (false = no pool).
--- @src _g.script: parse_names read via _G at call time (not loaded when this chunk runs under the stub load test).
local function get_section_pool(section)
    local cached = _pool_cache[section]
    if cached ~= nil then return cached or nil end
    local raw = ini_sys:r_string_ex(section, "npc_random")
    local pool = raw and parse_names(raw) or nil
    if not pool or #pool == 0 then
        _pool_cache[section] = false
        return nil
    end
    _pool_cache[section] = pool
    return pool
end

-- Snapshot SIMBOARD squad ids and reset the pass accumulators. False when no squads.
local function _start_pass()
    local ids, total = xsquad.collect_squad_ids(_sweep.ids)
    _sweep.ids = ids
    _sweep.total = total
    _sweep.cursor = 1
    local sim = alife()
    _cell_size  = sim and sim:switch_distance() or 0
    _cells      = {}
    _candidates = {}
    return total > 0
end

-- Examine one squad: accumulate its offline body count into the cells, and mark it a candidate if below its declared minimum with a random pool.
-- Skips: gone, empty, permanent, companion.
local function _collect_squad(squad_id)
    local squad = xobject.get_se(squad_id)
    if not squad or not squad.npc_count then return end
    local npc_count = squad:npc_count()
    if npc_count == 0 then return end
    if xsquad.is_permanent_squad(squad) or xsquad.is_companion(squad) then return end
    local online = squad.online
    if online then return end
    local pos = squad.position
    if not pos then return end
    local level_id = xlevel.get_level_id(squad)
    if not level_id then return end
    local key = xlevel.build_cell_key(level_id, pos, _cell_size)
    if not key then return end
    _cells[key] = (_cells[key] or 0) + npc_count
    if not is_refill_enabled() then return end
    local bin = ab_smart_recipe.get_faction_bin(squad.player_id)
    if not bin then return end
    local section = squad:section_name()
    local nmin = xsmart.get_section_npc_range(section)
    if nmin <= npc_count then return end
    if not get_section_pool(section) then return end
    _candidates[#_candidates + 1] = { id = squad.id, level_id = level_id, bin = bin, cell = key }
end

--- Walk up to `per_tick` squads; true when the pass wrapped (caller finalizes then).
function iterate_squads(per_tick)
    if not _sweep.active then
        if not _start_pass() then return false end
        _sweep.active = true
    end
    local last = _sweep.cursor + per_tick - 1
    if last > _sweep.total then last = _sweep.total end
    for i = _sweep.cursor, last do
        _collect_squad(_sweep.ids[i])
    end
    _sweep.cursor = last + 1
    if _sweep.cursor > _sweep.total then
        _sweep.active = false
        return true
    end
    return false
end

--- Console helper (ab_test): run one full sweep synchronously, return squads walked.
function iterate_all_squads()
    if not _start_pass() then return 0 end
    for i = 1, _sweep.total do
        _collect_squad(_sweep.ids[i])
    end
    _sweep.active = false
    return _sweep.total
end

-- Refill one candidate squad by a member, re-verifying its state fresh (the pass took minutes; it may have died, gone online, recovered, or lost its smart).
-- Every decline path counts its reason into acc so the [DRAIN] completion line explains the batch from the log alone.
local function _add_member(squad_id, acc)
    local squad = xobject.get_se(squad_id)
    if not squad then acc.gone = acc.gone + 1; return end
    if squad.online then acc.online = acc.online + 1; return end
    local npc_count = squad:npc_count()
    if npc_count == 0 then acc.gone = acc.gone + 1; return end
    local section = squad:section_name()
    local nmin = xsmart.get_section_npc_range(section)
    if nmin <= npc_count then acc.recovered = acc.recovered + 1; return end
    local rec = squad.smart_id and SIMBOARD.smarts[squad.smart_id]
    local smart = rec and rec.smrt
    if not smart then acc.no_smart = acc.no_smart + 1; return end
    local commander = xobject.get_se(squad:commander_id())
    if not commander then acc.no_commander = acc.no_commander + 1; return end
    if not xlevel.is_valid_lvid(commander) then acc.bad_lvid = acc.bad_lvid + 1; return end
    local pool = get_section_pool(section)
    if not pool then acc.no_pool = acc.no_pool + 1; return end
    local member_id = squad:add_squad_member(pool[math_random(#pool)],
        commander.position, commander.m_level_vertex_id, commander.m_game_vertex_id)
    if not member_id then acc.add_failed = acc.add_failed + 1; return end
    local se_member = xobject.get_se(member_id)
    if se_member then
        smart:register_npc(se_member)
        SIMBOARD:setup_squad_and_group(se_member)
    end
    squad:update()
    acc.added = acc.added + 1
    if _dbg then
        log.debug("[REFILL] squad=%d section=%s faction=%s now=%d min=%d",
            squad.id, section, tostring(squad.player_id), squad:npc_count(), nmin)
    end
end

--- Filter this pass's candidates against its verdicts and cell counts, then drain one squad per frame via xslice.
--- Called from ab_smart_balance._execute_pass after verdicts assign, so candidates, verdicts, and cells share one pass.
function start_drain()
    if #_candidates == 0 then return end
    if xslice.is_active(REFILL_JOB) then
        log.debug("[QUEUE] previous drain still active, skipping pass")
        return
    end
    local build = xprofiler.new_if(_dbg):start()
    local threshold = get_crowd_threshold()
    local work = {}
    local skipped_verdict, skipped_crowd = 0, 0
    for i = 1, #_candidates do
        local cand = _candidates[i]
        if ab_smart_balance.get_verdict(cand.level_id, cand.bin) < 0 then
            skipped_verdict = skipped_verdict + 1
        elseif (_cells[cand.cell] or 0) >= threshold then
            skipped_crowd = skipped_crowd + 1
        else
            work[#work + 1] = cand.id
        end
    end
    build:stop()
    if _dbg then
        local cell_count = 0
        for _ in pairs(_cells) do cell_count = cell_count + 1 end
        log.debug("[QUEUE] candidates=%d work=%d skipped_verdict=%d skipped_crowd=%d cells=%d [%.2fms]",
            #_candidates, #work, skipped_verdict, skipped_crowd, cell_count, build:get_ms())
    end
    if #work == 0 then return end
    local total = #work
    local acc = { added = 0, gone = 0, online = 0, recovered = 0, no_smart = 0,
                  no_commander = 0, bad_lvid = 0, no_pool = 0, add_failed = 0 }
    local frames = 0
    local start_time = os_clock()
    xslice.start(REFILL_JOB, work, {
        step = 1,
        func = function(squad_id)
            frames = frames + 1
            local frame_timer = xprofiler.new_if(_dbg):start()
            _add_member(squad_id, acc)
            frame_timer:stop()
            if _dbg then
                log.debug("[REFILL] squad=%d added_total=%d [%.2fms frame:%d]",
                    squad_id, acc.added, frame_timer:get_ms(), frames)
            end
            return true
        end,
        on_done = function()
            local elapsed_ms = (os_clock() - start_time) * 1000
            if acc.added > 0 then ab_smart_balance.add_refill_count(acc.added) end
            log.info("[DRAIN] added=%d/%d gone=%d online=%d recovered=%d no_smart=%d no_commander=%d bad_lvid=%d no_pool=%d add_failed=%d [%d frames %.0fms]",
                acc.added, total, acc.gone, acc.online, acc.recovered, acc.no_smart,
                acc.no_commander, acc.bad_lvid, acc.no_pool, acc.add_failed, frames, elapsed_ms)
        end,
    })
end

--- Drop pass state and cancel a running drain. Called from ab_smart_balance._reset_state
--- (save load); the section pool cache survives, squad_descr LTX is static.
function reset_state()
    xslice.stop_queue(REFILL_JOB, true)
    _sweep      = { ids = {}, total = 0, cursor = 1, active = false }
    _cell_size  = 0
    _cells      = {}
    _candidates = {}
end
