--- ab_smart_recipe: smart-terrain recipe analysis - the per-level slot-capacity model Smart Balance steers toward.

local pairs, ipairs, tonumber, tostring, type = pairs, ipairs, tonumber, tostring, type
local string_format, table_concat, string_find = string.format, table.concat, string.find
local math_floor, math_ceil, math_random = math.floor, math.ceil, math.random
local xlog, xsmart, xlevel, xcreature, xprofiler = xlog, xsmart, xlevel, xcreature, xprofiler
local ini_sys = ini_sys

--- Bin key for the mutant aggregate: every monster-faction squad bins here; humans bin under their own faction name.
MUTANTS = "__mutants"

local _dbg = false
-- _models[level_id] = { capacity[bin], eligible[bin]=smarts, smart_bins[smart_id]=bins, readers, smarts }; _inventoried[level_id] gates the DEBUG dump.
local _models      = {}
local _inventoried = {}

-- Population factors, ZCP-aware: engine reads alife_stalker_pop / alife_mutant_pop, ZCP replaces them with its MCM cvars (GAMMA seeds both 0.5).
-- @src smart_terrain.script:try_respawn: split into stalker/monster getters so the per-recipe classifier mirrors the engine's factor selection.
local function get_monster_pop_factor()
    if smr_amain_mcm and smr_amain_mcm.get_config and smr_amain_mcm.get_config("smr_enabled") then
        return smr_amain_mcm.get_config("monster_pop_factor") or 1
    end
    return ui_options.get("alife/general/alife_mutant_pop") or 1
end

local function get_stalker_pop_factor()
    if smr_amain_mcm and smr_amain_mcm.get_config and smr_amain_mcm.get_config("smr_enabled") then
        return smr_amain_mcm.get_config("stalker_pop_factor") or 1
    end
    return ui_options.get("alife/general/alife_stalker_pop") or 1
end

-- Mirror the engine's per-recipe factor selection: only recipes whose FIRST squad section has common=true are scaled.
-- @src smart_terrain.script:1675-1686: "simulation"/"zombied" section takes the monster factor, "sim_squad" the stalker, else unscaled.
local function _compute_recipe_factor(recipe, monster_factor, stalker_factor)
    local squads = recipe.squads
    local section = squads and squads[1]
    if not section then return 1 end
    if not ini_sys:r_bool_ex(section, "common") then return 1 end
    if string_find(section, "simulation") or string_find(section, "zombied") then
        return monster_factor
    elseif string_find(section, "sim_squad") then
        return stalker_factor
    end
    return 1
end

local log = xlog.get_logger("AB.SREC", { outfile = "alifebalance.log" })

-- "stalker|bandit" or "?" -- factions any squad section in this recipe can produce.
local function _format_recipe_factions(recipe)
    if not recipe.squads then return "?" end
    local seen = {}
    for _, section in ipairs(recipe.squads) do
        local faction = xsmart.get_section_faction(section)
        if faction then seen[faction] = true end
    end
    local out = {}
    for faction in pairs(seen) do out[#out + 1] = faction end
    if #out == 0 then return "?" end
    return table_concat(out, "|")
end

-- "recipe_a->stalker, recipe_b->bandit" or "none" -- one entry per recipe in the smart.
local function _format_smart_recipes(smart)
    if not smart.respawn_params then return "none" end
    local parts = {}
    for k, recipe in pairs(smart.respawn_params) do
        parts[#parts + 1] = tostring(k) .. "->" .. _format_recipe_factions(recipe)
    end
    if #parts == 0 then return "none" end
    return table_concat(parts, ", ")
end

-- True if any section in the recipe produces the bin.
local function _has_recipe_bin(recipe, bin)
    if not recipe.squads then return false end
    for _, section in ipairs(recipe.squads) do
        if get_section_bin(section) == bin then return true end
    end
    return false
end

-- Dump every smart on the level once per session at DEBUG: routing-faction + recipe map, so the player sees why a smart is or isn't eligible.
-- _inventoried gates once per level; reset on log-level change so toggling DEBUG re-dumps.
local function _log_inventory(level_id)
    if not _dbg then return end
    if _inventoried[level_id] then return end
    _inventoried[level_id] = true
    local board = SIMBOARD
    if not board or not board.smarts then return end
    local total = 0
    for _, rec in pairs(board.smarts) do
        local smart = rec.smrt
        if smart and xlevel.get_level_id(smart) == level_id then
            total = total + 1
            log.debug("[INVENTORY] level=%d smart=%s routing=%s recipes=[%s]",
                level_id, smart:name() or "?",
                tostring(smart.faction), _format_smart_recipes(smart))
        end
    end
    log.debug("[INVENTORY] level=%d total_smarts=%d", level_id, total)
end

-- CONDLIST WALKER

-- Info-portion condition (type 1 positive, 2 negative). Dispatch: infop[3] -> npc-side; else actor; else sim:has_info(0,..); else pass.
local function _check_info_condition(infop, npc_info, actor, sim, is_negative)
    local has_info
    if infop[3] then
        if not npc_info then return true end
        has_info = npc_info:has_info(infop[1])
    elseif actor then
        has_info = actor:has_info(infop[1])
    elseif sim then
        has_info = sim:has_info(0, infop[1])
    else
        return true
    end
    if is_negative then return not has_info end
    return has_info and true or false
end

-- xr_conditions functor (cond type 3 = positive, 4 = negative). Missing functors pass.
local function _check_function_condition(infop, obj, npc, is_negative)
    local fn = xr_conditions[infop[1]]
    if not fn then return true end
    local result = fn(obj, npc, infop[3])
    if is_negative then return not result end
    return result and true or false
end

-- Random gate (cond type 5). Fails when infop[3] < math.random(100).
local function _check_random_condition(infop)
    if not infop[3] then return true end
    return infop[3] >= math_random(100)
end

-- Dispatch one condition entry by type; unknown types pass (engine permissive).
-- npc_info = npc for npc-side dispatch, nil when the actor was passed as npc; npc still goes to xr_conditions functors.
local function _check_condition_entry(infop, obj, npc, npc_info, actor, sim)
    local ctype = infop[2]
    if ctype == 1 then return _check_info_condition(infop, npc_info, actor, sim, false) end
    if ctype == 2 then return _check_info_condition(infop, npc_info, actor, sim, true) end
    if ctype == 3 then return _check_function_condition(infop, obj, npc, false) end
    if ctype == 4 then return _check_function_condition(infop, obj, npc, true) end
    if ctype == 5 then return _check_random_condition(infop) end
    return true
end

-- All conditions in a cond[2] list must pass for the cond to match.
local function _check_all_conditions(conds, obj, npc, npc_info, actor, sim)
    for j = 1, #conds do
        if not _check_condition_entry(conds[j], obj, npc, npc_info, actor, sim) then
            return false
        end
    end
    return true
end

-- LEVEL MODEL

-- Effective concurrent-squad SLOT cap for one recipe, nil when the engine would skip it.
-- @src smart_terrain.script:1665-1702: mirrors the try_respawn gates (bookkeeping, faction_controlled with default_faction seed at :1659, heli/empty).
-- @src _g.script:773: common recipes scale by round_idp(raw*pop_factor); ceil is an identity with the engine's max>num gate (1.5->2, chance <1 ->1).
local function _compute_recipe_slot_cap(recipe, k, smart, monster_factor, stalker_factor)
    local spawned = smart.already_spawned and smart.already_spawned[k]
    if not (recipe.num and spawned and spawned.num) then return nil end
    local faction = smart.faction or smart.default_faction
    if smart.faction_controlled ~= nil
       and not (faction ~= nil and recipe.faction == faction) then
        return nil
    end
    if not recipe.squads or #recipe.squads == 0 then return nil end
    local raw = tonumber(select_value_readonly(recipe.num, db.actor, smart)) or 0
    if raw <= 0 then return nil end
    local factor = _compute_recipe_factor(recipe, monster_factor, stalker_factor)
    local eff = (factor ~= 1) and math_floor(raw * factor + 0.5) or raw
    if eff <= 0 then return nil end
    return math_ceil(eff)
end

-- Fold one recipe into capacity and the smart's bin set, in SLOT units, attributed to bins by section fraction.
-- @src smart_terrain.script:1707,1716: engine picks one section per spawn, num counts any section; same fractions both sides keep cap/actual comparable.
local function _add_recipe_to_model(smart, k, recipe, slot_cap, model, bins_here)
    local per_bin = {}
    local total = #recipe.squads
    for _, section in ipairs(recipe.squads) do
        local bin = get_section_bin(section)
        if bin then
            per_bin[bin] = (per_bin[bin] or 0) + 1
        end
    end
    local fracs = {}
    for bin, count in pairs(per_bin) do
        local frac = count / total
        fracs[bin] = frac
        model.capacity[bin] = (model.capacity[bin] or 0) + slot_cap * frac
        bins_here[bin] = true
    end
    model.readers[#model.readers + 1] = { smart = smart, key = k, fracs = fracs }
end

-- Register the smart under every bin its recipes produce, keep the reverse map, and append it to the level's flat smart array.
local function _register_smart_bins(smart, model, bins_here)
    local any = false
    for bin in pairs(bins_here) do
        any = true
        local arr = model.eligible[bin] or {}
        model.eligible[bin] = arr
        arr[#arr + 1] = smart
    end
    if any then
        model.smart_bins[smart.id] = bins_here
        model.smarts[#model.smarts + 1] = smart
    end
end

-- Fold one smart's recipes into the level model (capacity, eligibility, smart_bins, readers).
local function _add_smart_to_model(smart, model, monster_factor, stalker_factor)
    local bins_here = {}
    for k, recipe in pairs(smart.respawn_params) do
        local slot_cap = _compute_recipe_slot_cap(recipe, k, smart, monster_factor, stalker_factor)
        if slot_cap then
            _add_recipe_to_model(smart, k, recipe, slot_cap, model, bins_here)
        end
    end
    _register_smart_bins(smart, model, bins_here)
end

-- Walk the level's smarts on SIMBOARD into the model.
local function _build_model(level_id, model)
    local board = SIMBOARD
    if not board or not board.smarts then return end
    local monster_factor = get_monster_pop_factor()
    local stalker_factor = get_stalker_pop_factor()
    for _, rec in pairs(board.smarts) do
        local smart = rec.smrt
        if smart and smart.respawn_params and xlevel.get_level_id(smart) == level_id then
            _add_smart_to_model(smart, model, monster_factor, stalker_factor)
        end
    end
end

-- Fold one reader's floor-guarded num into the actual sums by its section fractions.
local function _collect_reader(reader, actual)
    local spawned = reader.smart.already_spawned
    local entry = spawned and spawned[reader.key]
    local num = entry and entry.num or 0
    if num <= 0 then return end
    for bin, frac in pairs(reader.fracs) do
        actual[bin] = (actual[bin] or 0) + num * frac
    end
end

-- BUDGET EVAL

-- Evaluate one recipe slot, or nil when the engine would skip it.
-- raw_max is the declared LTX capacity for the snapshot; effective max applies the mirrored factor (round-half-up >=1, optimistic on fractional).
-- @src smart_terrain.script:1666,1701-1702: no num or no live already_spawned[k].num -> engine logs ERROR and skips; AB skips silently.
-- @src smart_terrain.script:1667: faction_controlled spawns only matching-faction recipes; faction seeds from default_faction (:1648-1650), read-only.
local function _compute_recipe_budget(recipe, k, smart, bin, monster_factor, stalker_factor)
    local spawned = smart.already_spawned and smart.already_spawned[k]
    if not (recipe.num and spawned and spawned.num) then return nil end
    local faction = smart.faction or smart.default_faction
    if smart.faction_controlled ~= nil
       and not (faction ~= nil and recipe.faction == faction) then
        return nil
    end
    local cur = spawned.num
    local raw_max = tonumber(select_value_readonly(recipe.num, db.actor, smart)) or 0
    local factor = _compute_recipe_factor(recipe, monster_factor, stalker_factor)
    local effective_max = raw_max * factor
    local max = (effective_max >= 1) and math_floor(effective_max + 0.5) or effective_max
    local open = max > cur
    local eligible = open and _has_recipe_bin(recipe, bin)
    return cur, raw_max, open, eligible
end

-- Fold one evaluated recipe into the budget accumulator: track any-open, capture the first bin-matching winner, append the snapshot part.
local function _collect_recipe_budget(state, k, cur, raw_max, open, eligible)
    if open then state.any_open = true end
    if not state.matched_key and eligible then state.matched_key = k end
    local mark = (state.matched_key == k) and "*" or ""
    state.parts[#state.parts + 1] = string_format("%s%s %d/%d", mark, tostring(k), cur, raw_max)
end

-- Single-pass budget eval: for each recipe the engine would consider, the first with open budget AND a bin-matching section wins.
-- select_value_readonly runs once per recipe, so the gate decision and the printed snapshot read the same value.
function compute_bin_budget(smart, bin)
    if not smart.respawn_params then return nil, "[no respawn_params]" end
    local monster_factor = get_monster_pop_factor()
    local stalker_factor = get_stalker_pop_factor()
    local state = { parts = {}, any_open = false, matched_key = nil }
    for k, recipe in pairs(smart.respawn_params) do
        local cur, raw_max, open, eligible = _compute_recipe_budget(recipe, k, smart, bin, monster_factor, stalker_factor)
        if cur ~= nil then
            _collect_recipe_budget(state, k, cur, raw_max, open, eligible)
        end
    end
    return state.matched_key, string_format("[%s]%s",
        table_concat(state.parts, ", "), state.any_open and "" or " ALL_FULL")
end

function set_debug(dbg)
    _dbg = dbg and true or false
    if not dbg then _inventoried = {} end
end

--- Drop every cached level model, so condlist flips and mutator injections converge on the recompute cadence.
function clear_models()
    _models = {}
end

function reset_state()
    _models      = {}
    _inventoried = {}
end

--- Classify a squad section into a bin: MUTANTS for monster factions, the faction name for humans, nil when it has no faction field.
function get_section_bin(section)
    local faction = xsmart.get_section_faction(section)
    if not faction then return nil end
    if xcreature.is_monster_faction(faction) then return MUTANTS end
    return faction
end

--- Classify a squad's player_id into a bin (same key space as get_section_bin).
function get_faction_bin(faction)
    if not faction or faction == "" then return nil end
    if xcreature.is_monster_faction(faction) then return MUTANTS end
    return faction
end

--- Side-effect-free condlist evaluator: mirrors xr_logic condition-check semantics but SKIPS the cond[3] effects block.
--- Routing through the engine reader would fire spawn_num side effects at AB's pass cadence, not the engine's; read-only keeps AB's intent explicit.
--- @src xr_logic.script:365-499: condition semantics mirrored, effects at :447-494 skipped. Returns "" on nil, cond[1]/"" on match, nil on none.
function select_value_readonly(condlist, obj, npc)
    if not condlist then return "" end
    local npc_info = npc
    if npc_info then
        local id = (npc_info.id and type(npc_info.id) == "function") and npc_info:id() or npc_info.id
        if id == AC_ID then npc_info = nil end
    end
    local actor = db.actor
    local sim = alife()
    for i = 1, #condlist do
        local cond = condlist[i]
        local conds = cond[2]
        if not conds or _check_all_conditions(conds, obj, npc, npc_info, actor, sim) then
            return cond[1] or ""
        end
    end
    return nil
end

--- Live actual per bin in slot units: each reader's already_spawned[k].num by the same section fractions capacity used.
--- @src sim_squad_scripted.script:1028: the num decrement is unfloored, hence the floor guard in _collect_reader. Call per pass, never cache.
function read_actual(model)
    local actual = {}
    local readers = model.readers
    for i = 1, #readers do
        _collect_reader(readers[i], actual)
    end
    return actual
end

--- Set of level ids with at least one respawn-capable smart on SIMBOARD.
--- The judged set: each gets verdicts from the first pass, slot state readable immediately (no census sighting needed).
function get_respawn_level_ids()
    local out = {}
    local board = SIMBOARD
    if not board or not board.smarts then return out end
    for _, rec in pairs(board.smarts) do
        local smart = rec.smrt
        if smart and smart.respawn_params then
            local level_id = xlevel.get_level_id(smart)
            if level_id then out[level_id] = true end
        end
    end
    return out
end

--- Level model accessor, computed lazily and cached until clear_models / reset_state.
--- One walk builds capacity, eligibility, and the smart->bins reverse map together, so the three views can never disagree.
function get_level_model(level_id)
    local model = _models[level_id]
    if model then return model end
    _log_inventory(level_id)
    model = { capacity = {}, eligible = {}, smart_bins = {}, readers = {}, smarts = {} }
    local prof = xprofiler.new_if(_dbg):start()
    _build_model(level_id, model)
    prof:stop()
    _models[level_id] = model
    if _dbg then
        local parts = {}
        for bin, cap in pairs(model.capacity) do
            parts[#parts + 1] = string_format("%s=%.1f/%d",
                tostring(bin), cap, model.eligible[bin] and #model.eligible[bin] or 0)
        end
        log.debug("[MODEL] level=%d capacity/eligibles [%s] [%.2fms]",
            level_id, table_concat(parts, ", "), prof:get_ms())
    end
    return model
end
